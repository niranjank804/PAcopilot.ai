# PA-Copilot backend configuration — copy to backend/.env and fill in.
#
#   cp .env.example backend/.env
#
# Only SECRET_KEY has no default; everything else below is optional and
# shown with the value the app falls back to. Settings are defined in
# backend/src/core/config.py, which carries the reasoning for each default.
#
# Never commit backend/.env — .gitignore already excludes it.

# =====================================================================
# Required
# =====================================================================

# Signs every access and refresh token. Must be at least 32 characters —
# the app refuses to start below that, because a short key can be
# brute-forced offline from one captured token and used to mint a token
# for any user. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-48-random-bytes-at-least-32-chars

# =====================================================================
# Database — supply EITHER a URL or the five discrete fields
# =====================================================================

# Neon, Supabase and the Vercel integration inject this automatically.
# Takes precedence over the five fields below when both are present.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Render supplies these five separately.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=enterprise_ai
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Sized per worker process. With --workers 2 the real connection count
# against Postgres is twice these numbers.
# DATABASE_POOL_SIZE=20
# DATABASE_MAX_OVERFLOW=20

# The backend test suite never uses the database above. It connects to
# TEST_DATABASE_URL, which must be a local server (tests/conftest.py
# refuses a remote host), read from the environment or from
# backend/.env.test — not from this file. The docker-compose default:
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_ai_test

# =====================================================================
# Environment
# =====================================================================

# development | staging | production. Drives HSTS and error verbosity.
# Defaults to production so that forgetting to set it is the safe case.
ENVIRONMENT=development

# Interactive API docs follow DEBUG unless overridden here.
DEBUG=true
# EXPOSE_API_DOCS_OVERRIDE=true

# A rotating log file in addition to stdout. Leave unset on Render and
# Vercel: their disks are ephemeral or read-only, and stdout is collected.
# LOG_FILE=logs/application.log

# JSON array, not a comma-separated string.
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Used to build links inside emails (password reset). Not the API's URL.
FRONTEND_URL=http://localhost:3000

# =====================================================================
# Accounts
# =====================================================================

# New accounts (sign-up form or first Google sign-in) wait for an Org
# Admin to approve them under Users. Setting this to true lets them sign
# in immediately, holding DEFAULT_SIGNUP_ROLE — including read access to
# every TM1 connection in the organization they joined. Only for a
# deployment that strangers cannot reach.
# REGISTRATION_AUTO_APPROVE=false

# System role granted to every new account. Analyst = read + chat.
# DEFAULT_SIGNUP_ROLE=Analyst

# =====================================================================
# AI providers
# =====================================================================

# Without this the AI endpoints fail at call time, not at startup.
ANTHROPIC_API_KEY=

# Adaptive thinking is ON by default. Omitting the parameter on the wire
# means no thinking at all, which measurably degrades multi-step TM1
# work; AI_EFFORT is the cost dial to reach for first.
# AI_DEFAULT_MODEL=claude-opus-5

# The models a chat request may name. Anything else is refused (422),
# whatever the caller's role, because the quota counts tokens and a
# pricier model would be spend the limit never sees. JSON list; every
# entry must be priced in src/ai/pricing.py and include the default.
# AI_ALLOWED_MODELS=["claude-opus-5","claude-sonnet-5"]

# What a chat turn still in flight is assumed to cost until it reports,
# so concurrent requests at the edge of the quota are refused rather
# than all passing a check none has been charged for yet.
# AI_QUOTA_RESERVATION_TOKENS=50000
# AI_THINKING_ENABLED=true
# AI_EFFORT=high            # low | medium | high | xhigh | max

# Embeddings for knowledge-base search.
OPENAI_API_KEY=

# Global monthly cap across all organizations; unset means unlimited.
# AI_MONTHLY_TOKEN_LIMIT=

# =====================================================================
# TM1 / Planning Analytics
# =====================================================================

# Encrypts stored TM1 connection credentials. LOSING THIS MEANS EVERY
# SAVED TM1 CONNECTION MUST BE RE-ENTERED — back it up with your other
# secrets. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TM1_CREDENTIALS_KEY=

# Set to the old key during a key rotation so existing rows stay
# readable while they are re-encrypted; remove once rotation completes.
# TM1_CREDENTIALS_KEY_PREVIOUS=

# Every TM1 request carries this timeout, and the thread it runs on
# comes from a pool of this size — so a server that stops answering
# can hold at most this many threads, for at most this long.
# TM1_REQUEST_TIMEOUT_SECONDS=30
# TM1_MAX_CONCURRENT_CALLS=16

# A connection address that is a loopback, link-local or private IP is
# refused unless this is on. From a hosted deployment those addresses
# are the platform's own network; a self-hosted deployment whose TM1
# sits on the LAN sets this to true.
# TM1_ALLOW_PRIVATE_ADDRESSES=false

# Per-minute budgets for the routes that parse, embed, analyse or walk
# a whole model — separate from the AI and general windows.
# RATE_LIMIT_HEAVY_USER_PER_WINDOW=10
# RATE_LIMIT_HEAVY_ORG_PER_WINDOW=40

# =====================================================================
# Google sign-in
# =====================================================================

# Client ID only — safe to expose, and must match the frontend's
# NEXT_PUBLIC_GOOGLE_CLIENT_ID. No client secret is used: the backend
# verifies Google-issued ID tokens and never runs a code exchange.
GOOGLE_OAUTH_CLIENT_ID=

# =====================================================================
# Email (password reset, access requests)
# =====================================================================

# With SMTP_HOST unset, emails are written to the application log
# instead of being sent — fine locally, but it means "forgot password"
# silently reaches nobody in production.
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
# SMTP_PORT=587
# SMTP_USE_TLS=true

# Must be a domain you actually control and have SPF/DKIM/DMARC records
# for, or reset mail lands in spam. The default is a placeholder.
SMTP_FROM_EMAIL=no-reply@pa-copilot.local

# =====================================================================
# Optional integrations
# =====================================================================

# Error tracking. Unset disables reporting entirely.
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0

# Object storage for report artefacts.
S3_BUCKET=
S3_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
