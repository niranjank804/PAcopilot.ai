{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "pdx1"
  ],
  "functions": {
    "src/main.py": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/internal/cron/reap-executions",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/internal/cron/refresh-metadata",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/internal/cron/model-health",
      "schedule": "30 3 * * *"
    }
  ]
}
