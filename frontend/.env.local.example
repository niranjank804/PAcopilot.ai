NEXT_PUBLIC_API_URL=http://localhost:8000

# Identity shown on /privacy and /terms. Unset values render as a visible
# red placeholder on those pages rather than silently blank, so an
# unconfigured deployment is obvious. Nothing here is secret — these are
# inlined into the client bundle like every NEXT_PUBLIC_ value.
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_EMAIL=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_JURISDICTION=
