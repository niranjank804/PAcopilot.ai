# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the examples. A blanket .env* also swallowed
# .env.local.example, so a fresh clone had nothing documenting which
# NEXT_PUBLIC_ variables the app needs — and NEXT_PUBLIC_API_URL being
# unset is a silent, hard-to-diagnose failure rather than a loud one.
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Vitest coverage output
coverage/
